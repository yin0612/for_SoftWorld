{
  "name": "softworld-monitoring-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-14",
  "services": [
    { "binding": "COLLECTOR", "service": "softworld-monitoring-api" }
  ],
  "triggers": {
    "crons": [
      "17 * * * *",
      "0 4,9 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "softworld-monitoring",
      "database_id": "60e945d0-593c-467c-9dfa-27911af49130"
    }
  ],
  "vars": {
    "CORS_ORIGIN": "https://yin0612.github.io",
    "RULES_VERSION": "2026-10-08-rss-precision-v1"
  }
}
